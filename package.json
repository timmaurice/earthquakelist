{
  "name": "earthquakelist-card",
  "version": "1.0.0",
  "description": "A Lovelace card to display the latest earthquakes for a monitored location.",
  "homepage": "https://github.com/timmaurice/earthquakelist#readme",
  "bugs": {
    "url": "https://github.com/timmaurice/earthquakelist/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/timmaurice/earthquakelist.git"
  },
  "license": "MIT",
  "author": "Tim Maurice Bayer",
  "type": "module",
  "main": "custom_components/earthquakelist/earthquakelist-card.js",
  "scripts": {
    "build": "rollup -c",
    "check-format": "prettier --check .",
    "format": "prettier . --write",
    "lint": "eslint frontend/",
    "test": "NODE_ENV=production vitest run",
    "watch": "rollup -c -w"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "cssnano": "^8.0.7",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "rollup": "^4.62.5",
    "rollup-plugin-lit-css": "^6.0.1",
    "sass": "^1.103.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lit": "^3.3.3",
    "tslib": "^2.8.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
